# Copy to .env (next to config.yaml) and fill in.
# .env is git-ignored: it holds secrets and must never be committed.
# Variables already set in the shell or by a scheduler take precedence.

# Whatever io_sharepoint needs to reach SharePoint (credentials, drive ids), e.g.
# DRIVE_ID_SITE_A=
# DRIVE_ID_SITE_B=

# Only for the demo and the tests: a folder that stands in for SharePoint.
# Never set this for a real run.
# ML_SHAREPOINT_STANDIN=
