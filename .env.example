# Copy to .env (next to config.yaml) and fill in.
# .env is git-ignored: it holds secrets and must never be committed.
# Variables already set in the shell or by a scheduler take precedence.

# Whatever io_sharepoint needs to reach SharePoint (credentials, drive ids).

# The drive each site's files are on, as config.yaml's drive_id passes it on.
SHAREPOINT_DRIVE_A=""
SHAREPOINT_DRIVE_B=""

# Where each input is on SharePoint, as config.yaml's ${NAME} placeholders ask.
# A path is relative to its drive (drive_id in config.yaml); URL-encoding such as
# %20 is fine. Quote every value.
SHAREPOINT_VOCABULARY=""
SHAREPOINT_CATALOG=""
SHAREPOINT_BATCH_TABLE=""
SHAREPOINT_PHF_SITE_A=""
SHAREPOINT_PHF_SITE_B=""
SHAREPOINT_PARAM_MAPPING=""
SHAREPOINT_REMFG=""
SHAREPOINT_LV_COA=""
SHAREPOINT_RAW_MATERIALS=""
SHAREPOINT_INVESTIGATIONS=""
# The screening register (`ml screening`), e.g. next to the catalog.
SHAREPOINT_SCREENING=""
SHAREPOINT_SITE_MAPS_FOLDER=""
SHAREPOINT_SITE_MAPS_FILES=""

# With sources.databricks: true, the Acridine Orange readings to fetch: one
# name|parameter id|type entry per reading, separated by ';'. Single-quote it.
# e.g. DATABRICKS_AO_MAPPING='<name>|<parameter id>|<type>;<name>|<parameter id>|<type>'
DATABRICKS_AO_MAPPING=''

# Only for the demo and the tests: a folder that stands in for SharePoint.
# Never set this for a real run.
# ML_SHAREPOINT_STANDIN=
