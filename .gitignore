# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Secrets and local settings
.env

# Workspace data and outputs live outside the package; never commit real data.
/workspace/
/data/
/outputs/
/config/

# Generated by tests and the demo command
*.incomplete/
*.failed/

# The demo's generated data and runs; `python -m pvf.demo demo` writes them.
/demo/data/
/demo/tasks/*/runs/
/demo/run.log
