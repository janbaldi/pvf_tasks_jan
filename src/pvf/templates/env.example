# Copy to .env (in this workspace folder, next to pvf.yaml) and fill in.
# .env is git-ignored: it holds secrets and must never be committed.
# Variables already set in the shell or by a scheduler take precedence.

# Whatever io_sharepoint needs to reach SharePoint (credentials, drive ids), e.g.
# DRIVE_ID_GHENT=
# DRIVE_ID_TIGER=

# PRD allows `pvf build` to upload the PVF (with upload.enabled: true)
MODE=DEV
# Upload folder, used when upload.path in pvf.yaml is empty
# DATA_LINK=
